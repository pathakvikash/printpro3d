# Copy to .env.local (local) or set in the Vercel project settings. No real values here.

# --- AI drawing (/api/design): set ANTHROPIC_API_KEY, or the AI_* group for an OpenAI-compatible endpoint ---
# Anthropic API key (wins over every other provider)
ANTHROPIC_API_KEY=
# auto | anthropic | openai | claude-cli. A named provider is strict (no fallback); auto falls back anthropic -> openai-compatible -> claude-cli (claude-cli local dev only)
AI_PROVIDER=
# model id (default for anthropic: claude-haiku-5-5; openai-compatible has no default)
AI_MODEL=
# openai | openrouter | opencode | groq | together | ollama | lmstudio
# LM Studio (local dev only; localhost is unreachable on Vercel): AI_PRESET=lmstudio, AI_MODEL=qwen/qwen3.5-9b, AI_API_KEY unneeded. Needs a vision model for photos.
AI_PRESET=
# key for the preset / OpenAI-compatible endpoint
AI_API_KEY=
# any OpenAI-compatible base URL, e.g. https://host/v1 (wins over the preset's URL)
AI_BASE_URL=
# claude-cli is on automatically when running locally and `claude` is on PATH; 0 turns it off, 1 forces it on. Always off when NODE_ENV=production or VERCEL is set
AI_ALLOW_CLI=
# AI models per email per UTC day (default 3; the blueprint design flow defaults to 20). Counted before the paid call; cached repeats are free
AI_DAILY_PER_EMAIL=
# AI models per UTC day across everyone (default 40; the blueprint design flow defaults to 200)
AI_DAILY_TOTAL=
# AI revisions (/api/designs/[id]/revise) per design project (default 5)
AI_REVISIONS_PER_PROJECT=
# blueprint flow model tier (low = haiku-5-5, mid = sonnet-5-5, high = opus-5-5; Anthropic only): low | mid | high (Anthropic: haiku / sonnet / opus; default mid). AI_DESIGN_MODEL sets an exact model id and wins
AI_DESIGN_TIER=
AI_DESIGN_MODEL=

# --- AI model generation (/api/generate, Meshy) ---
# Meshy API key (paid plan); unset turns generation off
MESHY_API_KEY=
# optional Meshy API base URL (tests point it at a stub; default https://api.meshy.ai)
MESHY_BASE_URL=

# --- Email (Resend) ---
# Resend API key; without it no emails are sent
RESEND_API_KEY=
# where new-order and new-request emails go (also the reply-to of customer status emails)
ORDER_NOTIFY_TO=
# sender, e.g. PrintPro3D <orders@yourdomain.com>; default is Resend's test sender
ORDER_NOTIFY_FROM=
# public site URL, no trailing slash; used for links in emails
SITE_URL=

# Owner command, not an env var: npm run designs:prune deletes unordered design projects older than 30 days (run weekly)

# --- Admin (/admin) ---
# Google sign-in (Auth.js). Comma-separated Google emails allowed into /admin and /settings/ai; empty = admin disabled (503)
ADMIN_EMAILS=
# Google OAuth client (Cloud Console > APIs & Services > Credentials > Web application) and the session secret (openssl rand -base64 32)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# --- Storage ---
# Vercel Blob read-write token (the Blob store must be created as PRIVATE); set on Vercel so orders and uploads persist
BLOB_READ_WRITE_TOKEN=
# local disk folder for orders/, requests/, uploads/, ai-jobs/, ai-usage/, ratelimit/ (default: project root). Ignored when the Blob token is set
DATA_DIR=

# Set by the platform, not by you: NODE_ENV (production disables claude-cli), VERCEL (set on Vercel; without a Blob token data goes to /tmp and is lost)

# --- Public contact / business identity (all optional; each one only shows on the site when set) ---
# WhatsApp number with country code, digits only (e.g. 919876543210); shows the floating WhatsApp button
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone shown in the header (desktop) and used as a tel: link
NEXT_PUBLIC_PHONE=
# Legal/trading name shown in the footer
NEXT_PUBLIC_BUSINESS_NAME=
# City shown in the footer
NEXT_PUBLIC_BUSINESS_CITY=
# GST number shown in the footer
NEXT_PUBLIC_GSTIN=
