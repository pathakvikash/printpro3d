# Copy to .env.local (local) or set in the Vercel project settings. No real values here.

# --- AI drawing (/api/design): set ANTHROPIC_API_KEY, or the AI_* group for an OpenAI-compatible endpoint ---
# Anthropic API key (wins over every other provider)
ANTHROPIC_API_KEY=
# anthropic | openai | claude-cli; when set, no fallback to another provider
AI_PROVIDER=
# model id (default for anthropic: claude-haiku-5-5; openai-compatible has no default)
AI_MODEL=
# openai | openrouter | opencode | groq | together | ollama | lmstudio
AI_PRESET=
# key for the preset / OpenAI-compatible endpoint
AI_API_KEY=
# any OpenAI-compatible base URL, e.g. https://host/v1 (wins over the preset's URL)
AI_BASE_URL=
# 1 enables the claude-cli provider; local development only, always off when NODE_ENV=production or VERCEL is set
AI_ALLOW_CLI=
# AI models per email per UTC day (default 3)
AI_DAILY_PER_EMAIL=
# AI models per UTC day across everyone (default 40)
AI_DAILY_TOTAL=

# --- AI model generation (/api/generate, Meshy) ---
# Meshy API key (paid plan); unset turns generation off
MESHY_API_KEY=
# optional Meshy API base URL (tests point it at a stub; default https://api.meshy.ai)
MESHY_BASE_URL=

# --- Email (Resend) ---
# Resend API key; without it no emails are sent
RESEND_API_KEY=
# where new-order and new-request emails go (also the reply-to of customer status emails)
ORDER_NOTIFY_TO=
# sender, e.g. PrintPro3D <orders@yourdomain.com>; default is Resend's test sender
ORDER_NOTIFY_FROM=
# public site URL, no trailing slash; used for links in emails
SITE_URL=

# --- Admin (/admin) ---
# long random string; the admin page and /api/admin/* send it as Authorization: Bearer. Unset = admin disabled (503)
ADMIN_TOKEN=

# --- Storage ---
# Vercel Blob read-write token (the Blob store must be created as PRIVATE); set on Vercel so orders and uploads persist
BLOB_READ_WRITE_TOKEN=
# local disk folder for orders/, requests/, uploads/, ai-jobs/, ai-usage/, ratelimit/ (default: project root). Ignored when the Blob token is set
DATA_DIR=

# Set by the platform, not by you: NODE_ENV (production disables claude-cli), VERCEL (set on Vercel; without a Blob token data goes to /tmp and is lost)
